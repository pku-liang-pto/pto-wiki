{
  "name": "pto-cann-collections",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev wiki",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:build:pages": "node scripts/build-docs.mjs /pto-wiki/",
    "docs:preview": "vitepress preview wiki",
    "test:validators": "node --test scripts/tests/*.test.mjs",
    "agents:skills": "node scripts/validate-agent-skills.mjs",
    "agents:links": "node scripts/check-markdown-links.mjs AGENTS.md .agents wiki",
    "agents:check": "npm run agents:skills && npm run agents:links",
    "wiki:links": "node scripts/check-markdown-links.mjs wiki",
    "check": "npm run test:validators && npm run agents:check && npm run wiki:links && npm run docs:build && npm run docs:build:pages"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
